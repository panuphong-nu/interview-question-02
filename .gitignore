# Local configuration. Ignore every env file and re-admit only the tracked
# templates, so a new variant (.env.local, .env.production, .env.dev.local)
# cannot be committed by accident just because nobody added a rule for it.
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

