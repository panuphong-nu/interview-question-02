# Required: copy the connection string from Supabase Dashboard → Connect.
DATABASE_URL=

# Required: generate with `openssl rand -base64 48`.
JWT_SECRET=

# Optional defaults for local development.
# HTTP_ADDRESS=:4201
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Optional: used only by the `make *-secure` commands.
# INFISICAL_ENV=dev
